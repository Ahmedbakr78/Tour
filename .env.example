# Copy to `.env` (server) and/or set as Vercel project environment variables.
# The Vercel deploy reads these from the Vercel dashboard / `vercel env add`.

# --- MongoDB (REQUIRED for the API) ---
# MongoDB Atlas connection string, e.g.:
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.abc123.mongodb.net/tourmate

# --- Auth secrets (use long random strings) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS (comma-separated origins) ---
CORS_ORIGIN=https://tourmate-3cj.pages.dev,https://tourmate.vercel.app

# --- Optional ---
UPLOAD_DIR=./uploads
NODE_ENV=production
